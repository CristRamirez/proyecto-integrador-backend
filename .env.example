# Plantilla de variables de entorno. Copiar a .env y completar.
# .env NO se sube al repo (está en .gitignore).

# --- Cloudflare D1 HTTP REST API ---
# account_id y database_id no son secretos.
CF_ACCOUNT_ID=ded8e69142f5e5e43c544fa808d6f7dc
CF_D1_DATABASE_ID=e5c99209-e129-481c-9c9d-ab3b225b025f

# Token con permiso Account > D1 > Edit. SECRETO. Se genera en el dashboard.
CF_D1_API_TOKEN=pega-tu-token-aca

# --- Servidor ---
PORT=3000

# --- Sesión (token JWT) ---
JWT_SECRET=pega-una-clave-larga-aca
JWT_EXPIRES_IN=2h
