{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proyecto-integrador-backend",
  "main": "src/worker.mjs",

  // nodejs_compat habilita Express y, desde 2025-04-01, popula process.env
  // con las vars y los secrets del Worker (los lee src/config/env.js).
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Todos los días a las 03:05 UTC (00:05 en Argentina) aplica la mora a las
  // cuotas vencidas sin pago en término (BS-11). Lo atiende scheduled() en
  // src/worker.mjs.
  "triggers": {
    "crons": ["5 3 * * *"]
  },

  "observability": {
    "enabled": true
  },

  // La base entra como binding: el Worker la consulta directo, sin token.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proyecto-integrador-aca",
      "database_id": "6945c36e-cd61-4a86-8cd7-fa226645fae2"
    }
  ],

  // Valores publicos. El secreto (JWT_SECRET) va por `wrangler secret put`
  // o por el panel, nunca aca.
  "vars": {
    "NODE_ENV": "production",
    "JWT_EXPIRES_IN": "2h"
  }
}
